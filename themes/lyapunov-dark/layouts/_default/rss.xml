{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ with .Title }}{{ . }} — {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>en</language>
    {{- with site.Params.author.email }}
    <managingEditor>{{ . }}{{ with site.Params.author.name }} ({{ . }}){{ end }}</managingEditor>
    <webMaster>{{ . }}{{ with site.Params.author.name }} ({{ . }}){{ end }}</webMaster>
    {{- end }}
    {{- with (or site.Copyright site.Params.copyright) }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- $limit := site.Params.RSS.limit | default 15 }}
    {{- $contentLimit := site.Params.RSS.content | default 15 }}
    {{- $pages := sort (where site.RegularPages "Section" "post") "PublishDate" "desc" | first $limit }}
    {{- range $index, $page := $pages }}
    <item>
      <title>{{ $page.Title }}</title>
      <link>{{ $page.Permalink }}</link>
      <pubDate>{{ $page.PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ $page.Permalink }}</guid>
      <description>{{ $page.Summary | transform.XMLEscape | safeHTML }}</description>
      {{- if lt $index $contentLimit }}
      <content:encoded>{{ $page.Content | transform.XMLEscape | safeHTML }}</content:encoded>
      {{- end }}
      <dc:creator>{{ or $page.Params.author site.Params.author.name }}</dc:creator>
    </item>
    {{- end }}
  </channel>
</rss>
